# Local TTL data cache (scripts/cache.py)
reports/.cache/
# Local DuckDB/Parquet analytics read model (regenerated from reports/* sources)
reports/analytics/
# Local analytics health-check report (regenerated after analytics refresh)
reports/analytics_checks/
# SSHFS mountpoint for test-server DuckDB/Parquet analytics data
reports/analytics-remote/
# Local pipeline progress status (latest state for Streamlit; regenerated per run)
reports/run_status/
# Local candidate ranking snapshots (runtime history; test server stores this under shared/)
reports/candidate_rankings/
# Advisory writer lock; durable CSV data is committed, the process lock is not.
reports/performance_ledger.csv.lock

# Local IBKR account reconciliation — contains real positions/P&L, never commit
reports/reconciliation.json
# Local IBKR scanner watchlist (generated on-demand, machine-specific)
reports/watchlist.json
# Local X influencer picks (x_influencers --save; non-reproducible real-time search)
reports/x_influencer_picks.json
# Local social radar snapshots and optional AI summaries; test server stores this under shared/
reports/social_intelligence/
# Local on-demand LLM sector-rotation read (regenerated via the page button; non-reproducible)
reports/sector_rotation.json
# Local on-demand LLM theme money-flow read (主題資金流 page button; regenerated, non-reproducible)
reports/theme_flow.json
reports/theme_flow_snapshot.json
reports/theme_flow_snapshots/
# Local on-demand LLM per-ticker fundamentals read (個股總覽 ⑤基本面 button; regenerated, non-reproducible)
reports/fundamentals_read/
# Local opt-in saved AI chat sessions; may contain user questions / trading notes.
reports/ai_chat_sessions/
# Risk Guard scan output (風險雷達 --output / scheduled scan; regenerated, machine-specific)
reports/risk_guard/
# COT positioning snapshots (cot_es.py) + crypto universe scans (crypto_universe.py): regenerable pipeline
# output, currently untracked — regenerate on demand, do not bloat history.
reports/cot/
reports/crypto/
# 大盤行情研判 (market_thesis): regime_history.json is a regenerable local cache (ignored); but the dated
# forecast LEDGERS + validation_summary ARE committed (by CI) so forward validation accumulates, same as
# reports/reversal_radar/. Ignore the dir CONTENTS, then re-include the ledger families.
reports/market_thesis/*
!reports/market_thesis/forecast_*.json
!reports/market_thesis/regime_only_forecast_*.json
!reports/market_thesis/validation_summary.json
# delivered.json: a COMMITTED idempotent-delivery receipt (Codex MKT-P3 r7) so a rerun within the lock
# window never re-sends a forecast whose Telegram alert already went out. missed.json: a COMMITTED terminal
# receipt (r12) of ready forecasts that aged out undelivered — failed red once, then never rebound.
!reports/market_thesis/delivered.json
!reports/market_thesis/missed.json
# NOTE: reports/reversal_radar/ is intentionally NOT ignored — its dated scan_*.json are the
# forward-validation snapshots and must persist/commit across daily CI runs to accumulate
# (same as reports/oversold_reversal/). Committed by the CI "Commit reports back" step.
content/tv_signals.json

# Playwright-MCP per-run captures (UI snapshots / console logs — local session state,
# may include localhost URLs + pasted watchlist contents; never commit)
.playwright-mcp/
# Stray root-level UI snapshot PNGs (ui_snapshot.py / polish scratch)
/*.png

# Obsidian local vault state for knowledge/. Keep Markdown cards committed, but
# never commit machine-specific workspaces or downloaded plugins.
knowledge/.obsidian/workspace*.json
knowledge/.obsidian/plugins/

# Surge retrospective: 27MB control-pool feature dump, fully rewritten every run.
# Regenerable by retro_factor_lift before retro_modules reads it; aggregated
# results live in factor_lift.json. Kept out of git to avoid history bloat.
reports/retrospective/control_features.json
reports/retrospective/**/control_features.json

